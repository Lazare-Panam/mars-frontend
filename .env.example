# Public base URL of the product API. Override for local dev, e.g.
# http://localhost:5177/  — falls back to the production API if unset.
NEXT_PUBLIC_API_BASE_URL=https://mars-api.mangobeach-29eb5614.ukwest.azurecontainerapps.io/

# Public, absolute base URL of the site. Used for canonicals, JSON-LD, OG tags
# (metadataBase), and the generated sitemap. No trailing slash needed.
NEXT_PUBLIC_SITE_URL=https://www.marsvalvenok.com

# Cloudflare Turnstile SITE key (public — safe to commit). Rendered by the
# enquiry forms; the backend verifies the resulting token with the secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFwfb1up9rSC3yQN
